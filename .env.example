# Use separate fields: passwords need no URL escaping.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=retailpulse
PGUSER=retailpulse_app
PGPASSWORD=replace_with_your_local_password
PGSSLMODE=prefer
# Integration tests require a SEPARATE disposable database.
# RETAILPULSE_TEST_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/retailpulse_test
